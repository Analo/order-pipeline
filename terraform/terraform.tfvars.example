# Copy this file to terraform.tfvars and fill in your values.
# Never commit terraform.tfvars — it is in .gitignore.

project_name  = "order-pipeline"
environment   = "dev"
aws_region    = "eu-west-1"
owner         = "your-name"
alert_email   = "you@example.com"   # Leave as "" to skip SNS email subscription

# SQS
sqs_visibility_timeout = 90   # Must be >= lambda_timeout
sqs_max_receive_count  = 3    # Low for demo; use 5-10 in production

# Lambda
lambda_timeout = 30
lambda_memory  = 256

# DynamoDB
dynamodb_billing_mode = "PAY_PER_REQUEST"
dynamodb_ttl_days     = 7
